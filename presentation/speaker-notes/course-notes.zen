      text id="break.meta" x=(px)34 y=(px)42 w=(px)527 h=(px)16 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "BREAK / 1:50 - 2:00 / 10 MIN"
