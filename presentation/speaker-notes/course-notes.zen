  document id="doc.ai4cyber.notes" title="AI for Cybersecurity 101 - Speaker Notes" {
    page id="page.ch1" name="CH1 - Before class" w=(px)595 h=(px)842 background=(token)"color.bg" {
      rect id="ch1.accent" x=(px)34 y=(px)28 w=(px)527 h=(px)5 fill=(token)"color.accent"
      text id="ch1.meta" x=(px)34 y=(px)42 w=(px)527 h=(px)16 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "CH1 / Before class / PRE-WORK"
      }
      text id="ch1.title" x=(px)34 y=(px)62 w=(px)527 h=(px)34 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.title" font-weight=(token)"weight.bold" {
        span "LOCK YOUR DOORS"
      }
      text id="ch1.objective" x=(px)34 y=(px)100 w=(px)527 h=(px)40 fill=(token)"color.muted" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "Every builder account has a passkey or MFA, passwords live in a manager, and the lab runs on every laptop."
      }
      rect id="ch1.rule" x=(px)34 y=(px)146 w=(px)527 h=(px)1 fill=(token)"color.line"
      rect id="ch1.screen.bg" x=(px)34 y=(px)158 w=(px)527 h=(px)132 fill=(token)"color.panel" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch1.screen.label" x=(px)46 y=(px)168 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "ON SCREEN"
      }
      text id="ch1.screen.body" x=(px)46 y=(px)188 w=(px)503 h=(px)94 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "- Email first: it resets every other account\n- Passkey, then authenticator app, then SMS as a last resort\n- Password without MFA: 15 characters minimum (NIST SP 800-63B-4)\n- Lab ready: npm run check ends with All flags as expected."
      }
      rect id="ch1.say.bg" x=(px)34 y=(px)300 w=(px)527 h=(px)92 fill=(token)"color.panelStrong" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch1.say.label" x=(px)46 y=(px)310 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "SAY"
      }
      text id="ch1.say.body" x=(px)46 y=(px)330 w=(px)503 h=(px)54 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "While people sit down, ask for a show of hands on the lab check. Helpers walk to every hand that stays down. Nobody starts CH2 without a running lab."
      }
      rect id="ch1.blocks.bg" x=(px)34 y=(px)402 w=(px)527 h=(px)178 fill=(token)"color.panel" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch1.blocks.label" x=(px)46 y=(px)412 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "PROMPTS AND COMMANDS"
      }
      text id="ch1.blocks.body" x=(px)46 y=(px)432 w=(px)503 h=(px)140 fill=(token)"color.ink" font-family=(token)"font.mono" font-size=(token)"size.code" {
        span "$ npm run check"
      }
      rect id="ch1.close.bg" x=(px)34 y=(px)590 w=(px)527 h=(px)150 fill=(token)"color.panelStrong" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch1.close.label" x=(px)46 y=(px)600 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "CHECK / FALLBACK / CUE"
      }
      text id="ch1.close.body" x=(px)46 y=(px)620 w=(px)503 h=(px)112 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "CHECK: At least 90% of hands up for a running lab.\n\nFALLBACK: Pair a student without a running lab with a neighbour for CH2. A helper fixes the install during CH2.\n\nCUE: Hands up if npm run check printed All flags as expected."
      }
      text id="ch1.sources.label" x=(px)34 y=(px)752 w=(px)527 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "SOURCES"
      }
      text id="ch1.sources" x=(px)34 y=(px)768 w=(px)527 h=(px)56 fill=(token)"color.muted" font-family=(token)"font.mono" font-size=(token)"size.small" {
        span "NIST SP 800-63B-4: https://pages.nist.gov/800-63-4/sp800-63b.html"
      }
    }
    page id="page.ch2" name="CH2 - Think like the attacker" w=(px)595 h=(px)842 background=(token)"color.bg" {
      rect id="ch2.accent" x=(px)34 y=(px)28 w=(px)527 h=(px)5 fill=(token)"color.accent"
      text id="ch2.meta" x=(px)34 y=(px)42 w=(px)527 h=(px)16 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "CH2 / 0:00 - 0:25 / 25 MIN"
      }
      text id="ch2.title" x=(px)34 y=(px)62 w=(px)527 h=(px)34 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.title" font-weight=(token)"weight.bold" {
        span "THINK LIKE THE ATTACKER"
      }
      text id="ch2.objective" x=(px)34 y=(px)100 w=(px)527 h=(px)40 fill=(token)"color.muted" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "Explain how an AI-built app leaks without being hacked, state the legal line, and draft a one-page threat model."
      }
      rect id="ch2.rule" x=(px)34 y=(px)146 w=(px)527 h=(px)1 fill=(token)"color.line"
      rect id="ch2.screen.bg" x=(px)34 y=(px)158 w=(px)527 h=(px)132 fill=(token)"color.panel" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch2.screen.label" x=(px)46 y=(px)168 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "ON SCREEN"
      }
      text id="ch2.screen.body" x=(px)46 y=(px)188 w=(px)503 h=(px)94 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "- Moltbook, Feb 2026: Supabase RLS missing, about 1.5M API tokens exposed\n- Computer Crimes Act 1997 s.3: attack only LabShop or an app you own\n- Four questions: what are we building, what can go wrong, what will we do, did it work\n- OAuth consent phishing, session token theft, APK sideloading"
      }
      rect id="ch2.say.bg" x=(px)34 y=(px)300 w=(px)527 h=(px)92 fill=(token)"color.panelStrong" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch2.say.label" x=(px)46 y=(px)310 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "SAY"
      }
      text id="ch2.say.body" x=(px)46 y=(px)330 w=(px)503 h=(px)54 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "Nobody broke into Moltbook. The door was never locked. Then the legal line before any lab: test only what you own, use test data, report what you find elsewhere, never exploit it."
      }
      rect id="ch2.blocks.bg" x=(px)34 y=(px)402 w=(px)527 h=(px)178 fill=(token)"color.panel" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch2.blocks.label" x=(px)46 y=(px)412 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "PROMPTS AND COMMANDS"
      }
      text id="ch2.blocks.body" x=(px)46 y=(px)432 w=(px)503 h=(px)140 fill=(token)"color.ink" font-family=(token)"font.mono" font-size=(token)"size.code" {
        span "PROMPT / Threat model card:\nInterview me, one question at a time, then draft a one-page threat model of this app: assets, entry points, top 3 fears."
      }
      rect id="ch2.close.bg" x=(px)34 y=(px)590 w=(px)527 h=(px)150 fill=(token)"color.panelStrong" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch2.close.label" x=(px)46 y=(px)600 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "CHECK / FALLBACK / CUE"
      }
      text id="ch2.close.body" x=(px)46 y=(px)620 w=(px)503 h=(px)112 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "CHECK: Every student names three fears that point at their own code.\n\nFALLBACK: No app of their own: threat model LabShop with the worked example.\n\nCUE: Keep your top fear in mind. In CH3 we start with the cheapest leak there is: a key anyone can download."
      }
      text id="ch2.sources.label" x=(px)34 y=(px)752 w=(px)527 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "SOURCES"
      }
      text id="ch2.sources" x=(px)34 y=(px)768 w=(px)527 h=(px)56 fill=(token)"color.muted" font-family=(token)"font.mono" font-size=(token)"size.small" {
        span "Vibe-coding incidents 2026: https://decloak.dev/journal/uncloaked-380-000-exposed-apps-and-the-vibe-coding-security-problem-nobody-s-fixing"
      }
    }
    page id="page.ch3" name="CH3 - Secrets and AI context" w=(px)595 h=(px)842 background=(token)"color.bg" {
      rect id="ch3.accent" x=(px)34 y=(px)28 w=(px)527 h=(px)5 fill=(token)"color.accent"
      text id="ch3.meta" x=(px)34 y=(px)42 w=(px)527 h=(px)16 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "CH3 / 0:25 - 1:00 / 35 MIN"
      }
      text id="ch3.title" x=(px)34 y=(px)62 w=(px)527 h=(px)34 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.title" font-weight=(token)"weight.bold" {
        span "SECRETS AND AI CONTEXT"
      }
      text id="ch3.objective" x=(px)34 y=(px)100 w=(px)527 h=(px)40 fill=(token)"color.muted" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "Tell a public key from a secret key, scan full git history for leaks, and keep secrets out of the coding agent's context."
      }
      rect id="ch3.rule" x=(px)34 y=(px)146 w=(px)527 h=(px)1 fill=(token)"color.line"
      rect id="ch3.screen.bg" x=(px)34 y=(px)158 w=(px)527 h=(px)132 fill=(token)"color.panel" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch3.screen.label" x=(px)46 y=(px)168 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "ON SCREEN"
      }
      text id="ch3.screen.body" x=(px)46 y=(px)188 w=(px)503 h=(px)94 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "- NEXT_PUBLIC_, VITE_, EXPO_PUBLIC_ ship to every visitor\n- Publishable (anon) key: public, safe only with RLS on. Secret (service_role) key: never public\n- Lab F1: steal the service_role key from the bundle\n- Leaked key: rotate first, clean history second"
      }
      rect id="ch3.say.bg" x=(px)34 y=(px)300 w=(px)527 h=(px)92 fill=(token)"color.panelStrong" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch3.say.label" x=(px)46 y=(px)310 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "SAY"
      }
      text id="ch3.say.body" x=(px)46 y=(px)330 w=(px)503 h=(px)54 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "Share the problem with your agent, never the secret. A key you paste into a chat or commit once is burned, even after you delete it."
      }
      rect id="ch3.blocks.bg" x=(px)34 y=(px)402 w=(px)527 h=(px)178 fill=(token)"color.panel" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch3.blocks.label" x=(px)46 y=(px)412 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "PROMPTS AND COMMANDS"
      }
      text id="ch3.blocks.body" x=(px)46 y=(px)432 w=(px)503 h=(px)140 fill=(token)"color.ink" font-family=(token)"font.mono" font-size=(token)"size.code" {
        span "PROMPT / F1 attacker card:\nFind any secret that this app ships to the browser. Tell me which variable holds it and what that key can do. Do not change any code yet.\n\n$ sh scripts/proof.sh F1\n\n$ npm run reset -- --rotate-keys\n\n$ gitleaks git -v"
      }
      rect id="ch3.close.bg" x=(px)34 y=(px)590 w=(px)527 h=(px)150 fill=(token)"color.panelStrong" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch3.close.label" x=(px)46 y=(px)600 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "CHECK / FALLBACK / CUE"
      }
      text id="ch3.close.body" x=(px)46 y=(px)620 w=(px)503 h=(px)112 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "CHECK: proof.sh F1 shows only the anon role, and the agent refuses to read .env.\n\nFALLBACK: Agent stalls: use Exploit by hand on the F1 card. gitleaks missing: run it in a helper's terminal on a zip of the repo.\n\nCUE: The key is rotated. Now the database it guarded: CH4 opens with the hole that leaked Moltbook."
      }
      text id="ch3.sources.label" x=(px)34 y=(px)752 w=(px)527 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "SOURCES"
      }
      text id="ch3.sources" x=(px)34 y=(px)768 w=(px)527 h=(px)56 fill=(token)"color.muted" font-family=(token)"font.mono" font-size=(token)"size.small" {
        span "gitleaks: https://github.com/gitleaks/gitleaks\nClaude Code permissions: https://code.claude.com/docs/en/permissions"
      }
    }
    page id="page.ch4" name="CH4 - OWASP Top 10 hunt" w=(px)595 h=(px)842 background=(token)"color.bg" {
      rect id="ch4.accent" x=(px)34 y=(px)28 w=(px)527 h=(px)5 fill=(token)"color.accent"
      text id="ch4.meta" x=(px)34 y=(px)42 w=(px)527 h=(px)16 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "CH4 / 1:00 - 1:50 / 50 MIN"
      }
      text id="ch4.title" x=(px)34 y=(px)62 w=(px)527 h=(px)34 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.title" font-weight=(token)"weight.bold" {
        span "OWASP TOP 10 HUNT"
      }
      text id="ch4.objective" x=(px)34 y=(px)100 w=(px)527 h=(px)40 fill=(token)"color.muted" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "Exploit and fix six LabShop flags across four OWASP Top 10:2025 categories, then repeat two checks on your own app."
      }
      rect id="ch4.rule" x=(px)34 y=(px)146 w=(px)527 h=(px)1 fill=(token)"color.line"
      rect id="ch4.screen.bg" x=(px)34 y=(px)158 w=(px)527 h=(px)132 fill=(token)"color.panel" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch4.screen.label" x=(px)46 y=(px)168 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "ON SCREEN"
      }
      text id="ch4.screen.body" x=(px)46 y=(px)188 w=(px)503 h=(px)94 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "- A01 Broken Access Control: F2 RLS off, F3 IDOR\n- A02 Security Misconfiguration: F4 headers and CORS\n- A05 Injection: F5 stored XSS, F6 SQL injection\n- A08 Software or Data Integrity Failures: F7 unsigned webhook\n- Lightning round: A03, A04, A06, A07, A09, A10"
      }
      rect id="ch4.say.bg" x=(px)34 y=(px)300 w=(px)527 h=(px)92 fill=(token)"color.panelStrong" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch4.say.label" x=(px)46 y=(px)310 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "SAY"
      }
      text id="ch4.say.body" x=(px)46 y=(px)330 w=(px)503 h=(px)54 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "Same loop every time: attack, exploit, fix, restart, prove. The proof is a curl output that changes, not a feeling that it is fixed."
      }
      rect id="ch4.blocks.bg" x=(px)34 y=(px)402 w=(px)527 h=(px)178 fill=(token)"color.panel" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch4.blocks.label" x=(px)46 y=(px)412 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "PROMPTS AND COMMANDS"
      }
      text id="ch4.blocks.body" x=(px)46 y=(px)432 w=(px)503 h=(px)140 fill=(token)"color.ink" font-family=(token)"font.mono" font-size=(token)"size.code" {
        span "PROMPT / F2 attacker card:\nCheck whether the database itself enforces that users only see their own notes. Give me a curl command that lists every note using only the anon key.\n\n$ sh scripts/proof.sh F2 F3\n\n$ sh scripts/proof.sh F4\n\n$ sh scripts/proof.sh F5 F6\n\n$ sh scripts/proof.sh F7\n\n$ git diff main lab-fixed -- lab/"
      }
      rect id="ch4.close.bg" x=(px)34 y=(px)590 w=(px)527 h=(px)150 fill=(token)"color.panelStrong" stroke=(token)"color.line" stroke-width=(token)"size.stroke"
      text id="ch4.close.label" x=(px)46 y=(px)600 w=(px)503 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "CHECK / FALLBACK / CUE"
      }
      text id="ch4.close.body" x=(px)46 y=(px)620 w=(px)503 h=(px)112 fill=(token)"color.ink" font-family=(token)"font.display" font-size=(token)"size.body" {
        span "CHECK: proof.sh F2 to F7 all show the after output.\n\nFALLBACK: Behind on a lab: read the reference fix with git diff main lab-fixed -- lab/ and move on. Broken lab: npm run reset -- --code.\n\nCUE: Ten-minute break. Anyone behind: copy the reference fix during the break."
      }
      text id="ch4.sources.label" x=(px)34 y=(px)752 w=(px)527 h=(px)14 fill=(token)"color.accent" font-family=(token)"font.mono" font-size=(token)"size.meta" font-weight=(token)"weight.bold" {
        span "SOURCES"
      }
      text id="ch4.sources" x=(px)34 y=(px)768 w=(px)527 h=(px)56 fill=(token)"color.muted" font-family=(token)"font.mono" font-size=(token)"size.small" {
        span "OWASP Top 10:2025: https://top10.owasp.org/2025\nMDN HTTP Observatory: https://developer.mozilla.org/en-US/observatory"
      }
    }
    page id="page.break" name="BREAK - Break" w=(px)595 h=(px)842 background=(token)"color.bg" {
